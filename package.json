{
  "name": "workforce-command-center",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n command,vite \"npm run command:service\" \"vite --host 127.0.0.1\"",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "command:service": "node server/protected-admin-review-service.mjs",
    "command:smoke": "node scripts/check-admin-review-service.mjs",
    "command-boundary:smoke": "node scripts/check-command-production-boundary.mjs",
    "home:smoke": "node scripts/check-home-buttons.mjs",
    "safe-change:smoke": "node scripts/check-safe-preview.mjs",
    "preview-accounts:smoke": "node scripts/check-preview-accounts.mjs",
    "account-access:smoke": "node scripts/check-account-access-flow.mjs",
    "clickable-actions:smoke": "node scripts/check-clickable-actions.mjs",
    "dashboard-layout:smoke": "node scripts/check-dashboard-layout.mjs",
    "all-sections:smoke": "node scripts/check-all-role-sections.mjs",
    "information-flow:smoke": "node scripts/check-information-flow.mjs",
    "saved-data:smoke": "node scripts/check-saved-data-recovery.mjs",
    "visual-safety:smoke": "node scripts/check-visual-safety.mjs",
    "supabase-readiness:smoke": "node scripts/check-supabase-readiness.mjs",
    "performance:budget": "node scripts/check-app-size-and-speed.mjs",
    "safe-change:check": "npm run build && npm run performance:budget && npm run home:smoke && npm run command:smoke && npm run command-boundary:smoke && npm run safe-change:smoke && npm run preview-accounts:smoke && npm run account-access:smoke && npm run clickable-actions:smoke && npm run dashboard-layout:smoke && npm run all-sections:smoke && npm run information-flow:smoke && npm run saved-data:smoke && npm run visual-safety:smoke && npm run supabase-readiness:smoke"
  },
  "dependencies": {
    "@openai/agents": "^0.12.0",
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/supabase-js": "^2.108.2",
    "@vitejs/plugin-react": "5.0.4",
    "concurrently": "^10.0.3",
    "express": "^5.2.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.3",
    "zod": "^4.4.3"
  }
}
